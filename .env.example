# Database connection string (PostgreSQL). Required: the server refuses to boot if unset.
DATABASE_URL=

# Optional PostgreSQL SSL connection parameters (e.g. require, verify-full, and CA root cert path).
PGSSLMODE=
PGSSLROOTCERT=

# Secret key for HMAC-SHA256 signing of JWT session and verification tokens. Required: throws at boot if unset.
JWT_SECRET=

# Server port (optional, defaults to 3000) and runtime environment (optional, e.g. production, development, test).
PORT=
NODE_ENV=

# Log level for pino logger (optional, e.g. info, debug, warn, error).
LOG_LEVEL=

# Comma-separated browser origins allowed to call the API. Required: the server refuses to start if unset or empty.
ALLOWED_ORIGINS=https://example.com,https://www.example.com

# Public URL of the frontend application (optional, used in emails and redirects).
FRONTEND_URL=

# Optional sub-path prefix for API routing when hosted behind a reverse proxy.
BASE_PATH=

# Absolute base URL of the API server, baked into the frontend bundle at build time.
VITE_API_URL=https://api.example.com

# Optional demo account PINs for faculty and HOD portals in the frontend login interface.
VITE_DEMO_FACULTY_PIN=
VITE_DEMO_HOD_PIN=

# Razorpay API credentials for the subscription payment routes. If either is unset, those
# routes return 503 but the server still boots normally - never fall back to a default here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook signing secret, chosen by us in the Razorpay dashboard (Settings > Webhooks) when
# creating the webhook - this is NOT the same value as RAZORPAY_KEY_SECRET above and must
# never be set to it. If unset, incoming webhooks fail signature verification and are
# rejected with 400 (no boot-time check; the server still starts normally).
RAZORPAY_WEBHOOK_SECRET=

# Gmail credentials used to send registration OTP and password-reset emails (mailer.ts).
# EMAIL_APP_PASSWORD is a Gmail App Password, not the account password. If either is missing
# or empty, the server logs an error at boot naming which one but still starts normally -
# these emails will simply fail to send until both are set.
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Optional department setup JSON file path and default initial password for provisioned HOD account.
DEPARTMENT_SETUP_FILE=
HOD_INITIAL_PASSWORD=

# Admin account bootstrap credentials for provision-admin.ts. The script throws
# naming the missing variable if either is absent — no hardcoded fallback.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Replit deployment identifier (optional, set automatically by Replit environment).
REPL_ID=
