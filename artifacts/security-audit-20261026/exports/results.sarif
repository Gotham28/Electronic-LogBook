            "confidence": "high",
            "findingId": "csf_3e47c52f348d444f7672fc06",
            "occurrenceId": "occ_3350424d48c0dd9fae960ad6",
            "severity": "medium"
          },
          "ruleId": "payment-webhook-acknowledges-storage-failure",
          "ruleIndex": 4
        },
